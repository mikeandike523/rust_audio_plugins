#!/bin/bash

set -euo pipefail

dn="$(dirname "$(realpath "${BASH_SOURCE[0]}")")"

# Test to see if $dn/.venv/bin/activate exists
# if so, activate using that
# otherwise check for $dn/.venv/Scripts/activate (windows Git Bash)
# and activate using that

if [[ -f "$dn/.venv/bin/activate" ]]; then
    # Unix-like system
    source "$dn/.venv/bin/activate"
elif [[ -f "$dn/.venv/Scripts/activate" ]]; then
    # Windows Git Bash
    source "$dn/.venv/Scripts/activate"
else
    echo "Error: Virtual environment not found. Please run setup.sh first."
    exit 1
fi

"$@"

